# --- service ---
PORT=8787
# Key the POS / cashier UI must send as:  Authorization: Bearer <key>
API_KEY=dev-pos-key-change-me
# Shared secret Loyverse webhooks must send as: X-Webhook-Secret
LOYVERSE_WEBHOOK_SECRET=dev-webhook-secret-change-me

# --- omada backend ---
# mock = simulation (no controller needed).  live = real Omada Open API.
OMADA_MODE=mock

# Only used when OMADA_MODE=live  (see src/omada/live.ts before switching)
OMADA_BASE_URL=https://aps1-omada-northbound.tplinkcloud.com
OMADA_CID=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=

# --- housekeeping ---
# How often the janitor purges spent vouchers, in minutes
JANITOR_INTERVAL_MINUTES=15
# Start shedding used vouchers once a site passes this fraction of its cap
JANITOR_HIGH_WATER=0.75
