{
  "name": "cafe-voucher-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voucher issuing middleware between a POS (Loyverse) and TP-Link Omada hotspot vouchers.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.ts",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "typecheck": "tsc --noEmit",
    "cli": "node --disable-warning=ExperimentalWarning scripts/cli.ts",
    "capture": "node --disable-warning=ExperimentalWarning tools/capture-omada-api.ts",
    "probe": "node --disable-warning=ExperimentalWarning tools/probe-omada-auth.ts",
    "discover": "node --disable-warning=ExperimentalWarning tools/discover-voucher-codes.ts",
    "probe:validity": "node --disable-warning=ExperimentalWarning tools/probe-validity.ts",
    "verify:live": "node --disable-warning=ExperimentalWarning tools/verify-live.ts",
    "live": "node --disable-warning=ExperimentalWarning tools/cli-live.ts",
    "verify:expiry": "node --disable-warning=ExperimentalWarning tools/verify-expiry-status.ts",
    "login": "node --disable-warning=ExperimentalWarning tools/login.ts",
    "cleanup:tests": "node --disable-warning=ExperimentalWarning tools/cleanup-test-groups.ts",
    "verify:autocleanup": "node --disable-warning=ExperimentalWarning tools/verify-autocleanup.ts"
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
